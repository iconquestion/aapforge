{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/aapforge/aapforge.schema.json",
  "title": "AAPForge 源文件结构",
  "type": "object",
  "required": ["aapforge", "project", "cast", "scenes"],
  "properties": {
    "aapforge": {
      "type": "object",
      "required": ["schema_version"],
      "properties": {
        "schema_version": { "const": "1.0" }
      },
      "additionalProperties": false
    },
    "project": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "default_bg": {},
        "default_bgm": {}
      },
      "additionalProperties": false
    },
    "cast": {
      "type": "object",
      "additionalProperties": { "type": "object" }
    },
    "assets": {
      "type": "object",
      "properties": {
        "backgrounds": { "type": "array" },
        "sounds": { "type": "array" }
      },
      "additionalProperties": false
    },
    "scenes": {
      "type": "array",
      "minItems": 1
    },
    "extensions": {
      "type": "object"
    }
  },
  "patternProperties": {
    "^x_": {}
  },
  "additionalProperties": false
}
